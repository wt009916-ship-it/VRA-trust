  "components": {
    "schemas": {
      "Body_upload_api_projects__project_id__files_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_api_projects__project_id__files_post"
      },
      "Building": {
        "properties": {
          "use": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Use"
          },
          "location": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Location"
          },
          "region": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Region"
          },
          "area_m2": {
            "type": "number",
            "maximum": 10000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Area M2"
          },
          "floors": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 300.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Floors"
          },
          "floor_height_m": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 50.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Floor Height M"
          },
          "window_wall_ratio": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Window Wall Ratio"
          },
          "envelope": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4000
              },
              {
                "type": "null"
              }
            ],
            "title": "Envelope"
          },
          "hvac": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4000
              },
              {
                "type": "null"
              }
            ],
            "title": "Hvac"
          },
          "schedules": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4000
              },
              {
                "type": "null"
