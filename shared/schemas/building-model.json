  "additionalProperties": false,
  "properties": {
    "expected_revision": {
      "default": 0,
      "minimum": 0,
      "title": "Expected Revision",
      "type": "integer"
    },
    "name": {
      "default": "建筑模型",
      "maxLength": 120,
      "minLength": 1,
      "title": "Name",
      "type": "string"
