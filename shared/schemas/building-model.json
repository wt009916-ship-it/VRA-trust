        },
        "roof_u": {
          "exclusiveMinimum": 0.05,
          "maximum": 10,
          "title": "Roof U",
          "type": "number"
        },
        "floor_u": {
          "exclusiveMinimum": 0.05,
          "maximum": 10,
          "title": "Floor U",
          "type": "number"
        },
        "window_u": {
          "exclusiveMinimum": 0.1,
          "maximum": 8,
          "title": "Window U",
          "type": "number"
        },
        "window_shgc": {
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Window Shgc",
          "type": "number"
        },
        "window_wall_ratio": {
          "maximum": 0.6,
          "minimum": 0,
          "title": "Window Wall Ratio",
          "type": "number"
        },
        "heating_c": {
          "maximum": 28,
          "minimum": 5,
          "title": "Heating C",
          "type": "number"
        },
        "cooling_c": {
          "maximum": 40,
          "minimum": 18,
          "title": "Cooling C",
          "type": "number"
        },
        "infiltration_ach": {
          "maximum": 5,
          "minimum": 0,
          "title": "Infiltration Ach",
          "type": "number"
        },
        "ground_temperature_c": {
          "maximum": 50,
          "minimum": -30,
          "title": "Ground Temperature C",
          "type": "number"
        },
        "lights_w_m2": {
          "maximum": 50,
          "minimum": 0,
          "title": "Lights W M2",
          "type": "number"
        },
        "equipment_w_m2": {
          "maximum": 100,
          "minimum": 0,
          "title": "Equipment W M2",
          "type": "number"
        },
        "people_m2_person": {
          "exclusiveMinimum": 1,
          "maximum": 1000,
          "title": "People M2 Person",
          "type": "number"
        },
        "active_start": {
          "maximum": 22,
          "minimum": 0,
          "title": "Active Start",
          "type": "integer"
        },
        "active_end": {
          "maximum": 24,
          "minimum": 1,
          "title": "Active End",
          "type": "integer"
        },
        "north_deg": {
          "default": 0,
          "exclusiveMaximum": 360,
          "minimum": 0,
          "title": "North Deg",
          "type": "number"
        },
