          "enum": [
            "assumed_scenario",
            "documented"
          ],
          "title": "Basis",
          "type": "string"
        },
        "source_note": {
          "maxLength": 2000,
          "minLength": 10,
          "title": "Source Note",
          "type": "string"
        },
        "constructions": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/MaterialLayer"
            },
            "type": "array"
          },
          "propertyNames": {
            "enum": [
              "wall",
              "roof",
              "floor"
            ]
          },
          "title": "Constructions",
          "type": "object"
        },
        "ifc_unpaired_policy": {
          "default": "reject",
          "enum": [
            "reject",
            "adiabatic_scenario"
          ],
          "title": "Ifc Unpaired Policy",
          "type": "string"
        },
        "geometry_tolerance_m": {
          "default": 0,
          "maximum": 0.05,
          "minimum": 0,
          "title": "Geometry Tolerance M",
          "type": "number"
        }
      },
      "required": [
        "wall_u",
        "roof_u",
        "floor_u",
        "window_u",
        "window_shgc",
        "window_wall_ratio",
        "heating_c",
        "cooling_c",
        "infiltration_ach",
        "ground_temperature_c",
        "lights_w_m2",
        "equipment_w_m2",
        "people_m2_person",
        "active_start",
        "active_end",
        "basis",
        "source_note"
      ],
      "title": "Thermal",
      "type": "object"
    }
