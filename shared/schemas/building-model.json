{
  "$defs": {
    "BoundaryHint": {
      "additionalProperties": false,
      "properties": {
        "points": {
          "items": {
            "maxItems": 3,
            "minItems": 3,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "maxItems": 100,
          "minItems": 3,
          "title": "Points",
          "type": "array"
        },
        "classification": {
          "enum": [
            "INTERNAL",
            "EXTERNAL",
            "EXTERNAL_EARTH",
            "EXTERNAL_WATER",
            "EXTERNAL_FIRE",
            "NOTDEFINED"
          ],
          "title": "Classification",
          "type": "string"
        },
        "source_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "element_plane_range_m": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Element Plane Range M"
        }
      },
      "required": [
        "points",
        "classification",
        "source_id"
      ],
      "title": "BoundaryHint",
      "type": "object"
    },
    "MaterialLayer": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "thickness_m": {
          "exclusiveMinimum": 0.001,
          "maximum": 2,
          "title": "Thickness M",
          "type": "number"
        },
        "conductivity_w_mk": {
          "exclusiveMinimum": 0.005,
          "maximum": 400,
          "title": "Conductivity W Mk",
          "type": "number"
        },
        "density_kg_m3": {
          "maximum": 30000,
          "minimum": 1,
          "title": "Density Kg M3",
          "type": "number"
        },
        "specific_heat_j_kgk": {
          "maximum": 6000,
          "minimum": 100,
          "title": "Specific Heat J Kgk",
          "type": "number"
        }
      },
      "required": [
        "name",
        "thickness_m",
        "conductivity_w_mk",
        "density_kg_m3",
        "specific_heat_j_kgk"
      ],
      "title": "MaterialLayer",
      "type": "object"
    },
    "Room": {
      "additionalProperties": false,
      "properties": {
        "polygon": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "maxItems": 100,
          "minItems": 3,
          "title": "Polygon",
          "type": "array"
        },
        "elevation_m": {
          "default": 0,
          "maximum": 1500,
          "minimum": -100,
          "title": "Elevation M",
          "type": "number"
        },
        "height_m": {
          "default": 3,
          "exclusiveMinimum": 0.5,
          "maximum": 30,
          "title": "Height M",
          "type": "number"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,59}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "source_locator": {
          "default": "人工输入",
          "maxLength": 500,
          "minLength": 1,
          "title": "Source Locator",
          "type": "string"
        },
        "segments": {
          "items": {
            "$ref": "#/$defs/Segment"
          },
          "maxItems": 128,
          "title": "Segments",
          "type": "array"
        },
        "ifc_source": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ifc Source"
        },
        "boundary_hints": {
          "items": {
            "$ref": "#/$defs/BoundaryHint"
          },
          "maxItems": 500,
          "title": "Boundary Hints",
          "type": "array"
        },
        "conditioned": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": true,
          "title": "Conditioned"
        },
        "include_floor_area": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": true,
          "title": "Include Floor Area"
        }
      },
      "required": [
        "polygon",
        "id",
        "name"
      ],
      "title": "Room",
      "type": "object"
    },
    "Segment": {
      "additionalProperties": false,
      "properties": {
        "polygon": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "maxItems": 100,
          "minItems": 3,
          "title": "Polygon",
          "type": "array"
        },
        "elevation_m": {
          "default": 0,
          "maximum": 1500,
          "minimum": -100,
          "title": "Elevation M",
          "type": "number"
        },
        "height_m": {
          "default": 3,
          "exclusiveMinimum": 1e-06,
          "maximum": 30,
          "title": "Height M",
          "type": "number"
        }
      },
      "required": [
        "polygon"
      ],
      "title": "Segment",
      "type": "object"
    },
    "Thermal": {
      "additionalProperties": false,
      "properties": {
        "wall_u": {
          "exclusiveMinimum": 0.05,
