DEMO_MODE=false
ENERGYPLUS_EXE=F:/EnergyPlusV9-0-1/energyplus.exe
VRA_DATA_DIR=runtime
VRA_MAX_UPLOAD_MB=64
# First account initializes the administrator; subsequent registrations require an invitation.
VRA_REGISTRATION_MODE=invitation
# Local accounts and project ownership are enabled. HTTPS deployments must set true.
VRA_COOKIE_SECURE=false
# Linux identity secrets require a persistent Fernet key injected by the operator.
# Windows uses CurrentUser DPAPI when this variable is omitted.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# VRA_IDENTITY_KEY=<inject through your secret manager; never commit a real key>
# Identity connections and SMTP are configured in /admin#services.
# VRA_FRONTEND_DIR=<optional absolute production build directory for isolated acceptance>
# Keep localhost binding until cloud/proxy/TLS deployment is separately verified.

# Optional server-only provider secret; never prefix with VITE_.
# Windows developer UI stores the key using CurrentUser DPAPI.
# Linux deployment injects DEEPSEEK_API_KEY through the process environment.
DEEPSEEK_API_KEY=
# Local single-worker EnergyPlus budget, 30–7200 seconds; failures retain outputs.
# Complex models may need more than five minutes; this does not change physics.
VRA_ENGINE_TIMEOUT_SECONDS=1800
