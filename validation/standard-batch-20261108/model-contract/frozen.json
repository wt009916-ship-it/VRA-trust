{
  "cases": [
    {
      "id": "Q02-regression",
      "message": "对照本项目合成资料TEST 101和TEST 202的2.3.4条，均指定2024版；不存在于索引中的条款要单列未找到，不要用另一规范的同号条款替代。",
      "expected": [
        [
          "TEST 101",
          "2.3.4",
          2
        ]
      ],
      "missing": [
        "TEST 202",
        "2.3.4"
      ],
      "cohort": "regression"
    },
    {
      "id": "Q04",
      "message": "请分别摘录合成测试资料TEST 202的2024版1.2.3条和TEST 101的2024版2.3.4条，并给出各自PDF页码。只使用本项目已复核资料。",
      "expected": [
        [
          "TEST 202",
          "1.2.3",
          1
        ],
        [
          "TEST 101",
          "2.3.4",
          2
        ]
      ],
      "cohort": "fresh"
    },
    {
      "id": "Q05",
      "message": "本项目合成测试资料TEST 101（2024版）有两条需要对照：1.2.3和2.3.4。请查询这两条的原文和各自PDF页码，别只返回第一条。",
      "expected": [
        [
          "TEST 101",
          "1.2.3",
          1
        ],
        [
          "TEST 101",
          "2.3.4",
          2
        ]
      ],
      "cohort": "fresh"
    }
  ],
