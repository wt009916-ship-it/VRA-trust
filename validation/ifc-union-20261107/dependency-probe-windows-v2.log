__init__(self, vert_properties: ndarray[dtype=float64, shape=(*, *), order='C'], tri_verts: ndarray[dtype=uint64, shape=(*, 3), order='C'], merge_from_vert: ndarray[dtype=uint64, shape=(*), order='C'] | None = None, merge_to_vert: ndarray[dtype=uint64, shape=(*), order='C'] | None = None, run_index: ndarray[dtype=uint64, shape=(*), order='C'] | None = None, run_original_id: ndarray[dtype=uint32, shape=(*), order='C'] | None = None, run_transform: ndarray[dtype=float64, shape=(*, 4, 3), order='C'] | None = None, run_flags: ndarray[dtype=uint8, shape=(*), order='C'] | None = None, face_id: ndarray[dtype=uint64, shape=(*), order='C'] | None = None, halfedge_tangent: ndarray[dtype=float64, shape=(*, 3, 4), order='C'] | None = None, tolerance: float = 0) -> None
batch_boolean(manifolds: collections.abc.Sequence[manifold3d.Manifold], op: manifold3d.OpType) -> manifold3d.Manifold

Perform the given boolean operation on a list of Manifolds. In case of
Subtract, all Manifolds in the tail are differenced from the head. The
empty-input case returns a default-constructed Manifold; the
single-input case returns the input unchanged (a no-op identity, including
any attached ExecutionContext on that single input).
cube_volume 24.0
