### Ran Playwright code
```js
await (async(page)=>{
 const cid='cad_970df543018e4224b1debafcb76a5415';
 let stateCalls=0,detailCalls=0;
 const listener=r=>{if(r.url().endsWith('/cad-current-states'))stateCalls++;if(r.url().endsWith('/cad-inspections/'+cid))detailCalls++;};
 page.on('request',listener);
 try{
 await page.getByRole('combobox',{name:'查看构件来源、数量与属性',exact:true}).selectOption('45');
 for(let i=0;i<2;i++)await page.waitForResponse(r=>r.url().endsWith('/cad-current-states')&&r.status()===200,{timeout:12000});
 const select=page.getByRole('combobox',{name:'查看构件来源、数量与属性',exact:true});
 if(await select.inputValue()!=='45')throw Error('Selection reset by polling');
 const card=page.locator('[data-cad-record="'+cid+'"]');
 if(!(await card.innerText()).includes('体积 24 m³'))throw Error('Actual quantity missing');
 if(detailCalls!==0)throw Error('Unchanged record repeatedly downloaded');
 await card.screenshot({path:'output/playwright/cad-current-valid.png'});
 return {state_calls:stateCalls,detail_calls:detailCalls,selected:'45',quantity:24,selection_preserved:true};
 }finally{page.off('request',listener);}
}
)(page);
```
