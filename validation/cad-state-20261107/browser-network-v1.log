 await page.getByRole('button',{name:'立即核验状态',exact:true}).click();
 const record=await(await fresh).json();
 await card.getByRole('combobox',{name:'查看构件来源、数量与属性',exact:true}).waitFor({state:'visible'});
 if(record.status!=='parsed'||!(await card.innerText()).includes('体积 24 m³'))throw Error('Recovery missing');
 return {network_failure_cleared:true,recovery_fresh_get:true,quantity:24};
}
)(page);
