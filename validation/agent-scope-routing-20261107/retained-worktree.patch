--- a/tests/test_backup.py
+++ b/tests/test_backup.py
@@ -321,3 +321,36 @@ def test_claimed_success_without_native_artifacts_is_not_recoverable(cold,tmp_pa
     with closing(sqlite3.connect(root/'vra.sqlite3')) as con,con:
         con.execute('INSERT INTO jobs VALUES (?,?,?,?,NULL)', ('run_'+'d'*32,pid,'succeeded','{}'))
     with pytest.raises(ValueError,match='missing artifacts'):make(cold,tmp_path)
+
+
+@pytest.mark.parametrize('ddl', [
+    'CREATE INDEX records_catalog_scope ON records(project_id,kind)',
+    "CREATE INDEX records_catalog_scope ON records(kind,project_id) WHERE kind='cad'",
+    'CREATE INDEX unexpected_catalog ON records(kind,project_id)',
+    'CREATE TRIGGER records_catalog_scope AFTER INSERT ON records BEGIN DELETE FROM jobs; END',
+])
+def test_catalog_index_schema_allowlist_rejects_altered_sql(ddl):
+    with closing(sqlite3.connect(':memory:')) as con:
+        con.executescript(backup.SCHEMA)
+        con.execute(ddl)
+        with pytest.raises(ValueError, match='Unsupported database schema'):
+            backup.check_database(con, {}, lambda _: None)
+
+
+def test_legacy_backup_without_catalog_index_restores_then_app_builds_trusted_index(cold, tmp_path):
+    root, pid, fid, _ = cold
+    with closing(sqlite3.connect(root/'vra.sqlite3')) as con:
+        con.execute('DROP INDEX records_catalog_scope')
+        con.commit()
+        before = con.execute('SELECT * FROM records ORDER BY kind,id,revision').fetchall()
+    archive, digest = make(cold, tmp_path)
+    target = tmp_path/'restored_legacy'
+    backup.restore_backup(archive, target, digest)
+    with TestClient(create_app(target, start_worker=False)) as client:
+        result = client.post('/api/auth/login', json={'username':'backup_owner','password':'Backup-test-password-2026'})
+        assert result.status_code == 200
+        assert client.get(f'/api/projects/{pid}/files/{fid}').content == b'unit,value\nkWh,123.45\n'
+        assert client.get(f'/api/projects/{pid}/cad-catalog').json()['items'] == []
+    with closing(sqlite3.connect(target/'vra.sqlite3')) as con:
+        assert con.execute('SELECT * FROM records ORDER BY kind,id,revision').fetchall() == before
+        assert con.execute("SELECT sql FROM sqlite_master WHERE name='records_catalog_scope'").fetchone()[0] == 'CREATE INDEX records_catalog_scope ON records(kind,project_id)'
