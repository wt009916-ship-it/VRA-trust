                  }
                },
                {
                  "properties": {
                    "targets": {
                      "minItems": 1
                    },
                    "text": {
                      "const": ""
                    },
                    "standard_code": {
                      "type": "null"
                    },
                    "edition": {
                      "type": "null"
                    },
                    "clause_id": {
                      "type": "null"
                    },
                    "retrieval": {
                      "const": "lexical"
                    }
                  },
                  "required": [
                    "targets"
                  ]
                }
              ],
              "required": [
                "as_of"
              ],
              "type": "object",
              "properties": {
                "text": {
                  "default": "",
                  "maxLength": 1000,
                  "type": "string"
                },
                "standard_code": {
                  "anyOf": [
                    {
                      "maxLength": 80,
                      "minLength": 2,
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null
                },
                "edition": {
                  "anyOf": [
                    {
                      "maxLength": 40,
                      "minLength": 1,
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null
                },
                "clause_id": {
                  "anyOf": [
                    {
                      "maxLength": 60,
                      "minLength": 1,
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null
                },
                "retrieval": {
                  "default": "lexical",
                  "enum": [
                    "lexical",
                    "semantic"
                  ],
                  "type": "string"
                },
                "as_of": {
                  "format": "date",
                  "type": "string"
                },
                "limit": {
                  "default": 10,
                  "maximum": 20,
                  "minimum": 1,
                  "type": "integer"
                },
                "targets": {
