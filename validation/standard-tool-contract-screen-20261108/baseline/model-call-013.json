                "standard_code",
                "clause_id"
              ],
              "type": "object",
              "properties": {
                "key": {
                  "pattern": "^[A-Za-z0-9_-]{1,40}$",
                  "type": "string"
                },
                "standard_code": {
                  "maxLength": 80,
                  "minLength": 2,
                  "type": "string"
                },
                "edition": {
                  "anyOf": [
                    {
                      "maxLength": 40,
                      "minLength": 1,
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null
                },
                "clause_id": {
                  "maxLength": 60,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9.()-]+$",
                  "type": "string"
                }
              }
            }
          }
        }
      }
