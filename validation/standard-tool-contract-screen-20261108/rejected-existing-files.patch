     return answer
+
+
+def tool_query_schema(definition):
+    """Complete disjoint objects for decoders that cannot mix properties + oneOf.
+
+    The API Query still validates all inputs. The batch tool advertises only its
+    meaningful fields; omitted single-query fields retain their server defaults.
+    Source bounds and ExactTarget refs come from the same canonical definition.
+    """
+    single = {key: deepcopy(value) for key, value in definition.items() if key != 'oneOf'}
+    single['properties'].pop('targets')
+    batch = {'type': 'object', 'additionalProperties': False,
+             'required': ['as_of', 'targets'],
+             'properties': {key: deepcopy(definition['properties'][key])
+                            for key in ('targets', 'as_of', 'limit')}}
+    batch['properties']['targets']['minItems'] = 1
+    return {'oneOf': [single, batch]}
